import os
import socket
import time

# Twitch IRC Connection Settings
server = 'irc.chat.twitch.tv'
port = 6667

# Safely fetch settings from Render Environment Variables (with your defaults applied)
oauth = os.getenv('TWITCH_OAUTH')  # Pulls securely from Render environment variable
nickname = os.getenv('TWITCH_NICKNAME', 'the_insane_arcade')
channel = os.getenv('TWITCH_CHANNEL', '#cyri97')
message = os.getenv('TWITCH_MESSAGE', '$rpg boss event')

# Safety check: Stop the script if the OAuth token was not set in Render
if not oauth:
    raise ValueError("Missing TWITCH_OAUTH environment variable! Please add it in Render settings.")

# Connect to Twitch IRC
s = socket.socket()
s.connect((server, port))
s.send(f"PASS {oauth}\r\n".encode('utf-8'))
s.send(f"NICK {nickname}\r\n".encode('utf-8'))
s.send(f"JOIN {channel}\r\n".encode('utf-8'))

# Main loop to send periodic messages every 60 seconds
while True:
    s.send(f"PRIVMSG {channel} :{message}\r\n".encode('utf-8'))
    time.sleep(60)
